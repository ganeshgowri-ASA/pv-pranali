# =============================================================================
# PV-Pranali — Environment Variables Template
# Copy to .env and fill in real values. NEVER commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------------
# MiMo (primary LLM — MiMo V2.5)
# Obtain from your MiMo provider dashboard.
# -----------------------------------------------------------------------------
MIMO_API_KEY=mimo_placeholder_key
MIMO_BASE_URL=https://api.mimo.ai/v1
MIMO_MODEL=mimo-v2.5
# Off-peak window for heavy sessions (IST). Used by token_guard.sh.
MIMO_OFFPEAK_START=23
MIMO_OFFPEAK_END=8
# Hard token cap per session (8M per proposal; guard exits when reached).
MIMO_SESSION_TOKEN_CAP=8000000

# -----------------------------------------------------------------------------
# Supabase (Postgres + pgvector + Auth + Storage + Realtime)
# Project URL and anon/service-role keys from supabase.com → Project Settings → API.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder_anon
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder_service_role
# Direct Postgres connection string (used by setup_supabase.sh and pgvector).
SUPABASE_DB_URL=postgresql://postgres:placeholder_password@db.xxxxxxxxxxxxxxxxxxx.supabase.co:5432/postgres
# Legacy short alias kept for backward compat with earlier sessions.
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder_anon

# -----------------------------------------------------------------------------
# Railway (worker deployments — Skyvern, Celery queue)
# Token from railway.app → Account Settings → Tokens.
# -----------------------------------------------------------------------------
RAILWAY_TOKEN=railway_placeholder_token
RAILWAY_PROJECT_ID=placeholder_project_id
RAILWAY_ENVIRONMENT=production
# Set by setup_railway.sh after first provision; read-only thereafter.
RAILWAY_DEPLOY_URL=https://placeholder.up.railway.app

# -----------------------------------------------------------------------------
# Vercel (Streamlit console + landing page hosting)
# Token from vercel.com → Settings → Tokens.
# -----------------------------------------------------------------------------
VERCEL_TOKEN=placeholder_vercel_token
VERCEL_ORG_ID=placeholder_vercel_org_id
VERCEL_PROJECT_ID=placeholder_vercel_project_id
# Set by setup_vercel.sh after first link; read-only thereafter.
VERCEL_PREVIEW_URL=https://placeholder.vercel.app

# -----------------------------------------------------------------------------
# Mouser Electronics API (component sourcing — India-deliverable)
# API key from mouser.com → Developer Tools → API Keys.
# -----------------------------------------------------------------------------
MOUSER_API_KEY=placeholder_mouser_api_key
MOUSER_SEARCH_URL=https://api.mouser.com/api/v1/search/keyword
MOUSER_COUNTRY_CODE=IN

# -----------------------------------------------------------------------------
# DigiKey API (component sourcing — fallback / price comparison)
# Client ID + Secret from developer.digikey.com → My Apps.
# -----------------------------------------------------------------------------
DIGIKEY_CLIENT_ID=placeholder_digikey_client_id
DIGIKEY_CLIENT_SECRET=placeholder_digikey_client_secret
DIGIKEY_TOKEN_URL=https://api.digikey.com/v1/oauth2/token
DIGIKEY_SEARCH_URL=https://api.digikey.com/Search/v3/Products/Keyword

# -----------------------------------------------------------------------------
# Unipile (LinkedIn outreach drafts via unified messaging API)
# DSN from app.unipile.com → Connections → DSN.
# -----------------------------------------------------------------------------
UNIPILE_DSN=placeholder_unipile_dsn
UNIPILE_API_URL=https://api1.unipile.com:13613
# LinkedIn account ID within Unipile (set after connecting account).
UNIPILE_LINKEDIN_ACCOUNT_ID=placeholder_linkedin_account_id

# -----------------------------------------------------------------------------
# GitHub (MCP bus + repo operations)
# Fine-grained PAT with repo + workflow scopes.
# -----------------------------------------------------------------------------
GITHUB_TOKEN=ghp_placeholder_token
GITHUB_ORG=ganeshgowri-ASA
GITHUB_REPO=pv-pranali

# -----------------------------------------------------------------------------
# Anthropic / Claude Code (fallback reasoning; MiMo is primary)
# Key from console.anthropic.com → API Keys.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-placeholder
